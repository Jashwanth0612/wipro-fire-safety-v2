# Existing MongoDB connection; never commit credentials.
MONGO_URI=
MONGO_DB=wiprofire
# A random signing secret of at least 32 bytes.
JWT_SECRET=
ADMIN_EMAIL=
# Local Mongo compatibility only: pbkdf2_sha256$600000$<hex-salt>$<hex-digest>
ADMIN_PASSWORD_HASH=
# Optional: contact, catalogue and admin work without AI credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=https://wipro-fire-safety-v2.vercel.app
# Only used by the retained legacy Node server, not the current Python API.
ADMIN_USERNAME=admin

# Supabase V2 (server only; never prefix these with VITE_)
# Keep mongo until the migration and access tests succeed.
DATA_BACKEND=mongo
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
