# Existing MongoDB connection; never commit credentials.
MONGO_URI=
MONGO_DB=wiprofire
# A random signing secret of at least 32 bytes.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: contact, catalogue and admin work without AI credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173,https://wipro-fire-safety-v2.vercel.app
# Only used by the retained legacy Node server, not the current Python API.
ADMIN_USERNAME=admin
